# No contract addresses are committed to this repository. Every one of them
# comes from here, which means a build that does not carry these variables runs
# as a demonstration rather than as a shop.
#
# That fallback is silent by design. If a deployment "stops taking money", read
# `isLive` in the browser console before reading anything else.

# ShellrPacks. The switch between the browser roll and the shop.
NEXT_PUBLIC_PACKS_ADDRESS=

# ShellrStockPacks. Unset, the /stocks desk renders and cannot buy.
NEXT_PUBLIC_STOCK_PACKS_ADDRESS=

# ShellrStaking, and the token it takes.
NEXT_PUBLIC_STAKING_ADDRESS=
NEXT_PUBLIC_SHELLR_TOKEN=

# Optional. The public RPC is rate limited; put an Alchemy or Chainstack URL
# here before any real traffic.
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
