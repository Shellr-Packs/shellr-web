# Set this after `npm run deploy` in keeper/ prints the contract address.
#
# It is the single switch between the two modes: unset, the site rolls packs in
# the browser and spends nothing; set, the Buy button asks for a wallet, sends
# ETH, and shows what the swap actually delivered. Everything that branches on
# it reads `isLive` in src/lib/chain/config.ts.
NEXT_PUBLIC_PACKS_ADDRESS=

# Optional. The public RPC is rate limited; put an Alchemy or Chainstack URL
# here before any real traffic.
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
